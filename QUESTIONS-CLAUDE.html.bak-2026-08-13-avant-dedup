});

function normalize(str) {
  return str.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
}

// --- Curseur "depuis ma dernière visite" (localStorage best-effort, dégradation gracieuse) ---
// localStorage n'est pas contractuel en file:// (MDN) : tout est protégé par try/catch. Sans
// stockage disponible, tout est considéré "ancien" et le compteur Nouveau reste masqué.
const CURSOR_KEY = 'journal-derniere-visite-v3';
let storageOk = true;
let cursorValue = null; // ISO ; null = pas de comparaison possible (1re visite ou stockage indisponible)

function setCursor(iso) {
  try { localStorage.setItem(CURSOR_KEY, iso); return true; } catch (e) { return false; }
}

(function initCursor() {
  try {
    const testKey = '__journal_test__';
    localStorage.setItem(testKey, '1');
    localStorage.removeItem(testKey);
  } catch (e) {
    storageOk = false;
    cursorValue = null;
    return;
  }
  try {
    const stored = localStorage.getItem(CURSOR_KEY);
    if (stored) {
      cursorValue = stored;
    } else {
      // 1re visite : rien à comparer encore (rien n'est affiché "nouveau"), mais on amorce le
      // curseur à maintenant pour que les visites suivantes puissent comparer.
      cursorValue = null;
      localStorage.setItem(CURSOR_KEY, new Date().toISOString());
    }
  } catch (e) {
    storageOk = false;
    cursorValue = null;
  }
})();

function isNew(e) {
  return storageOk && cursorValue !== null && new Date(e.quand_utc).getTime() > new Date(cursorValue).getTime();
}

function humanizeDelta(ms) {
  const min = Math.floor(ms / 60000);
  if (min < 1) return "à l'instant";
  if (min < 60) return 'il y a ' + min + ' min';
  const h = Math.floor(min / 60);
  if (h < 24) return 'il y a ' + h + ' h';
  const j = Math.floor(h / 24);
  return 'il y a ' + j + ' j';
}

function switchTab(tab, opts) {
  opts = opts || {};
  activeTab = tab;
  const isJournal = tab === 'journal';
  const isPlans = tab === 'plans';
  const isTaches = tab === 'taches';
  panelJournal.hidden = !isJournal;
  panelPlans.hidden = !isPlans;
  panelTaches.hidden = !isTaches;
  tabBtnJournal.setAttribute('aria-selected', isJournal ? 'true' : 'false');
  tabBtnPlans.setAttribute('aria-selected', isPlans ? 'true' : 'false');
  tabBtnTaches.setAttribute('aria-selected', isTaches ? 'true' : 'false');
  try { localStorage.setItem('journal-active-tab', tab); } catch (e) {}
  if (opts.updateHash !== false) {
    const target = '#' + tab;
    if (window.location.hash !== target) { window.location.hash = target; }
  }
}
tabBtnJournal.addEventListener('click', () => switchTab('journal'));
