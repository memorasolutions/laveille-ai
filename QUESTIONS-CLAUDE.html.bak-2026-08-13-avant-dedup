  body.innerHTML = html;
  body.querySelectorAll('[data-attend-idx]').forEach(a => {
    a.addEventListener('click', function (ev) {
      ev.preventDefault();
      const idx = parseInt(this.dataset.attendIdx, 10);
      top[idx].action();
    });
  });
}

