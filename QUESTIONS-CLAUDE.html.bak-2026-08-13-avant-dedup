  });
  const top = items.slice(0, 5);
  if (top.length === 0) {
    body.innerHTML = '<div class="ops-attend-empty">Rien ne t\'attend.</div>';
    return;
  }
  let html = '<ul class="ops-attend-list">';
  top.forEach((it, idx) => {
    html += '<li><a href="#" data-attend-idx="' + idx + '">' + it.label + '</a></li>';
