<!DOCTYPE html>
<html lang="fr-CA">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>laveille.ai - Journal de communication</title>
<!-- CONVENTION (fondateur 2026-08-06) : le titre DOIT commencer par le nom du projet (repérage des onglets Chrome). Si le projet a un logo : l'encoder en data URI et (1) l'ajouter ici en favicon <link rel="icon" type="image/png" href="data:image/png;base64,...">, (2) l'afficher dans le h1 de l'en-tête (img 40x40, border-radius 8px, avant le texte). Sans logo : titre texte seul. -->
<!-- Favicon = logo du projet s'il existe (data URI) ; sans logo, SUPPRIMER la ligne suivante -->
<link rel="icon" type="image/png" href="data:image/svg+xml;base64,">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #ffffff;
    --card-bg: #ffffff;
    --text: #1e1e1e;
    --text-secondary: #555;
    --border: #e0e0e0;
    --shadow: 0 2px 8px rgba(0,0,0,0.08);
    --badge-bg: #f0f0f0;
    --link: #0057b3;
    --accent: #0057b3;
    --search-bg: #f5f5f5;
    --btn-bg: #e8e8e8;
    --btn-hover: #d0d0d0;
    --btn-active: #0057b3;
    --btn-active-text: #fff;
    --highlight: #fff9c4;
    --code-bg: #f5f2f0;
    --pastille-size: 12px;
  }
  [data-theme="dark"] {
    --bg: #121212;
    --card-bg: #1e1e1e;
    --text: #e0e0e0;
    --text-secondary: #aaa;
    --border: #333;
    --shadow: 0 2px 8px rgba(0,0,0,0.4);
    --badge-bg: #2a2a2a;
    --link: #8ab4f8;
    --accent: #8ab4f8;
    --search-bg: #2a2a2a;
    --btn-bg: #333;
    --btn-hover: #444;
    --btn-active: #8ab4f8;
    --btn-active-text: #000;
    --highlight: #5c4a00;
    --code-bg: #2a2a2a;
  }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    padding: 16px;
    transition: background 0.3s, color 0.3s;
  }
  .hidden { display: none !important; }
  .container { max-width: 900px; margin: 0 auto; }
  header { margin-bottom: 16px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; }
  header h1 { font-size: 1.6rem; font-weight: 600; margin-right: auto; }
  .logo-projet { height: 34px; width: auto; vertical-align: middle; margin-right: 10px; background: #fff; border-radius: 6px; padding: 3px; }
  header .subtitle { width: 100%; color: var(--text-secondary); font-size: 0.9rem; margin-top: -8px; }
  header .meta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 8px; width: 100%; }
  .theme-toggle {
    background: var(--btn-bg); border: 1px solid var(--border); color: var(--text);
    padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; cursor: pointer;
    transition: background 0.2s; margin-left: auto;
  }
  .theme-toggle:hover { background: var(--btn-hover); }

  /* En-tête opérationnel unique (v3) */
  .ops-bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
    margin-bottom: 12px; padding: 10px 14px; background: var(--card-bg); border: 1px solid var(--border);
    border-radius: 12px; box-shadow: var(--shadow);
  }
  .ops-counters { display: flex; flex-wrap: wrap; gap: 8px; }
  .ops-counter {
    background: var(--btn-bg); border: 1px solid var(--border); color: var(--text);
    padding: 5px 12px; border-radius: 16px; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: background 0.2s;
  }
  .ops-counter:hover { background: var(--btn-hover); }
  .ops-silence { font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap; }
  .ops-attend {
    margin-bottom: 16px; padding: 12px 16px; background: var(--card-bg); border: 1px solid var(--border);
    border-radius: 12px; box-shadow: var(--shadow); transition: box-shadow 0.2s;
  }
  .ops-attend.highlight { box-shadow: 0 0 0 3px var(--accent), var(--shadow); }
  .ops-attend-titre { font-weight: 700; font-size: 0.9rem; margin-bottom: 8px; }
  .ops-attend-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .ops-attend-list li { font-size: 0.88rem; }
  .ops-attend-list a { color: var(--link); text-decoration: none; }
  .ops-attend-list a:hover { text-decoration: underline; }
  .ops-attend-empty { color: #2e7d32; font-size: 0.88rem; font-weight: 600; }
  [data-theme="dark"] .ops-attend-empty { color: #81c784; }

  .tabs { display: flex; gap: 4px; margin-bottom: 16px; border-bottom: 1px solid var(--border); }
  .tab-btn {
    background: transparent; border: none; border-bottom: 3px solid transparent; color: var(--text-secondary);
    padding: 10px 16px; font-size: 0.95rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;
    transition: color 0.2s, border-color 0.2s;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn[aria-selected="true"] { color: var(--accent); border-bottom-color: var(--accent); }
  .tab-badge {
    background: var(--badge-bg); color: var(--text-secondary); font-size: 0.75rem; font-weight: 600;
    padding: 1px 8px; border-radius: 10px; min-width: 18px; text-align: center;
  }
  .tab-btn[aria-selected="true"] .tab-badge { background: var(--accent); color: var(--btn-active-text); }

  .controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; align-items: center; }
  .search-box {
    flex: 1 1 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: 24px;
    background: var(--search-bg); color: var(--text); font-size: 0.95rem; outline: none; transition: border 0.2s;
  }
  .search-box:focus { border-color: var(--accent); }

  .presets-row { display: flex; flex-wrap: wrap; gap: 8px; width: 100%; }
  .preset-btn {
    background: var(--btn-bg); border: 1px solid var(--border); color: var(--text);
    padding: 6px 14px; border-radius: 18px; font-size: 0.85rem; font-weight: 500; cursor: pointer;
    transition: all 0.2s; white-space: nowrap;
  }
  .preset-btn:hover { background: var(--btn-hover); }
  .preset-btn.active { background: var(--btn-active); color: var(--btn-active-text); border-color: var(--btn-active); }

  .filtres-avancees { width: 100%; }
  .filtres-avancees summary {
    cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); padding: 6px 0; user-select: none;
  }
  .filtres-avancees summary:hover { color: var(--text); }
  .adv-filters { display: flex; flex-direction: column; gap: 10px; padding: 10px 0 4px; }
  .adv-filter-group { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .adv-label { font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-right: 2px; }
  .adv-checkbox { display: inline-flex; align-items: center; gap: 4px; font-size: 0.82rem; cursor: pointer; }
  .adv-checkbox input { cursor: pointer; }
  .btn-reset {
    align-self: flex-start; background: transparent; border: 1px solid var(--border); color: var(--text-secondary);
    padding: 4px 12px; border-radius: 16px; font-size: 0.78rem; cursor: pointer; transition: background 0.2s;
  }
  .btn-reset:hover { background: var(--btn-hover); }

  .count-bar { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 6px; }
  .masked-note { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px; }
  .masked-note.hidden { display: none; }
  .btn-voir-tout {
    background: none; border: none; color: var(--link); text-decoration: underline; font-size: 0.85rem; cursor: pointer; padding: 0;
  }
  .btn-tout-lu {
    background: none; border: none; color: var(--link); text-decoration: underline; font-size: 0.8rem; cursor: pointer; padding: 0; margin-bottom: 10px; display: block;
  }
  .btn-page-suivante {
    display: block; margin: 14px auto 4px; background: var(--btn-bg); border: 1px solid var(--border); color: var(--text);
    padding: 8px 18px; border-radius: 20px; font-size: 0.85rem; cursor: pointer; transition: background 0.2s;
  }
  .btn-page-suivante:hover { background: var(--btn-hover); }
  .separateur-visite {
    display: flex; align-items: center; gap: 10px; margin: 6px 0 10px; color: var(--text-secondary); font-size: 0.78rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;
  }
  .separateur-visite::before, .separateur-visite::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  .cards-container { display: flex; flex-direction: column; gap: 12px; }
  .card {
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px;
    padding: 16px; box-shadow: var(--shadow); position: relative;
    transition: box-shadow 0.2s, background 0.3s; scroll-margin-top: 16px;
  }
  .card.highlight { box-shadow: 0 0 0 3px var(--accent), var(--shadow); }
  .card-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .pastille { width: var(--pastille-size); height: var(--pastille-size); border-radius: 50%; flex-shrink: 0; }
  .type-label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }
  .card-sujet { font-weight: 600; font-size: 1rem; margin-bottom: 4px; word-break: break-word; }
  .card-horodatage {
    font-size: 0.8rem; color: var(--text-secondary); display: flex; gap: 8px;
    align-items: center; margin-bottom: 8px; flex-wrap: wrap;
  }
  .card-horodatage .utc { font-size: 0.7rem; opacity: 0.7; }
  .card-contenu { margin-bottom: 10px; word-break: break-word; }
  .card-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
  .badge {
    display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 0.75rem;
    font-weight: 500; background: var(--badge-bg); color: var(--text);
  }
  .badge.statut { font-weight: 600; }
  .badge.statut.en-attente { background: #ffa000; color: #000; }
  .badge.statut.repondu { background: #388e3c; color: #fff; }
  .badge.statut.clos { background: #757575; color: #fff; }
  .badge.statut.info { background: #1976d2; color: #fff; }
  .badge.priorite.haute { background: #d32f2f; color: #fff; }
  .badge.priorite.normale { background: #f57c00; color: #fff; }
  .badge.priorite.basse { background: #6d6d6d; color: #fff; }
  .badge.plan-statut.en-attente-validation { background: #ffa000; color: #000; }
  .badge.plan-statut.valide { background: #388e3c; color: #fff; }
  .badge.plan-statut.rejete { background: #d32f2f; color: #fff; }
  .badge.plan-statut.en-cours { background: #1976d2; color: #fff; }
  .badge.plan-statut.termine { background: #757575; color: #fff; }
  .badge.plan-statut.abandonne { background: #616161; color: #fff; }
  .badge.plan-statut.en-pause { background: #455a64; color: #fff; }
  .card-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .card-links a { color: var(--link); font-size: 0.85rem; text-decoration: underline; }
  .card-todo { font-size: 0.8rem; background: var(--badge-bg); padding: 2px 8px; border-radius: 8px; display: inline-block; }
  .card-actions { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
  .btn-copy-link, .btn-copy-reponse {
    background: transparent; border: 1px solid var(--border); color: var(--text-secondary);
    padding: 4px 10px; border-radius: 16px; font-size: 0.75rem; cursor: pointer; transition: background 0.2s;
  }
  .btn-copy-link:hover, .btn-copy-reponse:hover { background: var(--btn-bg); }
  .no-results { text-align: center; padding: 40px 20px; color: var(--text-secondary); font-size: 1.1rem; }

  .rich-content h3 { font-size: 1.05rem; margin: 16px 0 8px; }
  .rich-content h3:first-child { margin-top: 0; }
  .rich-content p { margin-bottom: 0.6em; }
  .rich-content ul { margin-left: 1.2em; margin-bottom: 0.6em; }
  .rich-content table { border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 0.9rem; }
  .rich-content th, .rich-content td { border: 1px solid var(--border); padding: 6px 10px; text-align: left; }
  .rich-content th { background: var(--badge-bg); font-weight: 600; }
  .rich-content code { background: var(--code-bg); padding: 1px 4px; border-radius: 4px; font-size: 0.9em; }
  .rich-content .checklist { list-style: none; margin-left: 0; }
  .rich-content .checklist li { padding: 3px 0; display: flex; gap: 8px; align-items: flex-start; }
  .rich-content .check-fait { color: #2e7d32; font-weight: 700; }
  .rich-content .check-a-faire { color: var(--text-secondary); font-weight: 700; }

  /* Onglet Tâches (v3) */
  .taches-groupe { margin-bottom: 20px; }
  .taches-groupe-titre { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; color: var(--text-secondary); margin-bottom: 8px; }
  .tache-item {
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px;
    padding: 12px 16px; box-shadow: var(--shadow); margin-bottom: 10px; scroll-margin-top: 16px;
    transition: box-shadow 0.2s;
  }
  .tache-item.highlight { box-shadow: 0 0 0 3px var(--accent), var(--shadow); }
  .tache-header { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; }
  .tache-n { font-size: 0.78rem; color: var(--text-secondary); font-weight: 600; }
  .tache-sujet { font-weight: 600; font-size: 0.95rem; margin-bottom: 4px; }
  .tache-meta { font-size: 0.8rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 3px; margin-top: 6px; }
  .badge.tache-statut { font-weight: 600; }
  .badge.tache-statut.bloque { background: #d32f2f; color: #fff; }
  .badge.tache-statut.en_cours { background: #1976d2; color: #fff; }
  .badge.tache-statut.a_venir { background: #607d8b; color: #fff; }
  .badge.tache-statut.complete { background: #388e3c; color: #fff; }
  .badge.tache-statut.sans-preuve { background: #ffa000; color: #000; }
  .taches-collapse-groupe { margin-bottom: 10px; }
  .taches-collapse-groupe summary { cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); padding: 8px 0; user-select: none; }
  .taches-collapse-groupe summary:hover { color: var(--text); }

  .tab-panel[hidden] { display: none; }

  @media (max-width: 600px) {
    body { padding: 12px; }
    header h1 { font-size: 1.3rem; }
    .card, .tache-item { padding: 12px; }
    .preset-btn { font-size: 0.78rem; padding: 5px 10px; }
    .tab-btn { padding: 8px 10px; font-size: 0.88rem; }
    .ops-bar { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1><img src="data:image/svg+xml;base64," alt="Logo du projet" class="logo-projet" onerror="this.style.display='none'"> laveille.ai - Journal de communication</h1>
    <div class="subtitle">MEMORA solutions - toutes les questions, réponses, indications, tâches et plans de travail, horodatés (heure du Québec)</div>
    <div class="meta">
      <button class="theme-toggle" id="themeToggle" aria-label="Basculer le thème">Thème sombre</button>
    </div>
  </header>

  <div class="ops-bar" id="opsBar">
    <div class="ops-counters" role="group" aria-label="Résumé opérationnel">
      <button type="button" class="ops-counter" id="opsCounterNouveau">Nouveau (<span id="opsNouveauN">0</span>)</button>
      <button type="button" class="ops-counter" id="opsCounterAMoi">À moi (<span id="opsAMoiN">0</span>)</button>
      <button type="button" class="ops-counter" id="opsCounterSansPreuve">Complété sans preuve (<span id="opsSansPreuveN">0</span>)</button>
    </div>
    <span class="ops-silence" id="opsSilence">Dernière écriture : -</span>
  </div>

  <div class="ops-attend" id="opsAttend">
    <div class="ops-attend-titre">Ça t'attend</div>
    <div id="opsAttendBody"></div>
  </div>

  <div class="tabs" role="tablist" aria-label="Sections du journal">
    <button class="tab-btn" id="tabBtnJournal" type="button" role="tab" aria-selected="true" aria-controls="panelJournal" data-tab="journal">Journal <span class="tab-badge" id="badgeJournalTab">0</span></button>
    <button class="tab-btn" id="tabBtnPlans" type="button" role="tab" aria-selected="false" aria-controls="panelPlans" data-tab="plans">Plans <span class="tab-badge" id="badgePlansTab">0</span></button>
    <button class="tab-btn" id="tabBtnTaches" type="button" role="tab" aria-selected="false" aria-controls="panelTaches" data-tab="taches">Tâches <span class="tab-badge" id="badgeTachesTab">0</span></button>
  </div>

  <div class="tab-panel" id="panelJournal" role="tabpanel" aria-labelledby="tabBtnJournal">
    <div class="controls">
      <input type="text" class="search-box" id="searchInput" placeholder="Rechercher un ou plusieurs mots (sujet, contenu, type, statut...)" autocomplete="off">
      <div class="presets-row" id="presetsRow" role="group" aria-label="Filtres rapides">
        <button class="preset-btn" type="button" data-preset="a-traiter" data-label="À traiter pour moi">À traiter pour moi (0)</button>
        <button class="preset-btn" type="button" data-preset="questions-ouvertes" data-label="Questions ouvertes">Questions ouvertes (0)</button>
        <button class="preset-btn" type="button" data-preset="decisions-indications" data-label="Décisions et indications">Décisions et indications (0)</button>
        <button class="preset-btn" type="button" data-preset="tout" data-label="Tout">Tout (0)</button>
      </div>
      <details class="filtres-avancees" id="filtresAvancees">
        <summary>Filtres avancés</summary>
        <div class="adv-filters">
          <div class="adv-filter-group">
            <span class="adv-label">Type :</span>
            <label class="adv-checkbox"><input type="checkbox" data-group="type" value="question-pour-stephane"> Question pour Stéphane</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="type" value="reponse-de-stephane"> Réponse de Stéphane</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="type" value="reponse-de-claude"> Réponse de Claude</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="type" value="indication"> Indication</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="type" value="decision-requise"> Décision requise</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="type" value="note"> Note</label>
          </div>
          <div class="adv-filter-group">
            <span class="adv-label">Statut :</span>
            <label class="adv-checkbox"><input type="checkbox" data-group="statut" value="en-attente"> En attente</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="statut" value="repondu"> Répondu</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="statut" value="clos"> Clos</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="statut" value="info"> Info</label>
          </div>
          <div class="adv-filter-group">
            <span class="adv-label">Priorité :</span>
            <label class="adv-checkbox"><input type="checkbox" data-group="priorite" value="haute"> Haute</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="priorite" value="normale"> Normale</label>
            <label class="adv-checkbox"><input type="checkbox" data-group="priorite" value="basse"> Basse</label>
          </div>
          <button class="btn-reset" type="button" id="btnResetAdv">Réinitialiser</button>
        </div>
      </details>
    </div>

    <div class="count-bar" id="countBar">Aucune entrée affichée</div>
    <button type="button" class="btn-tout-lu hidden" id="btnToutLu">Tout marquer comme lu</button>
    <div class="masked-note hidden" id="maskedNote"></div>
    <div class="cards-container" id="cardsContainer"></div>
    <button type="button" class="btn-page-suivante hidden" id="btnAfficherPlus">Afficher les 50 suivantes</button>
  </div>

  <div class="tab-panel" id="panelPlans" role="tabpanel" aria-labelledby="tabBtnPlans" hidden>
    <div class="count-bar" id="countBarPlans">Aucun plan affiché</div>
    <div class="cards-container" id="plansContainer"></div>
  </div>

  <div class="tab-panel" id="panelTaches" role="tabpanel" aria-labelledby="tabBtnTaches" hidden>
    <div class="count-bar" id="countBarTaches">Aucune tâche affichée</div>
    <div class="masked-note hidden" id="tachesMaskedNote"></div>
    <div id="tachesContainer"></div>
  </div>
</div>

<script>
// SCHEMA_VERSION 3 (2026-08-07) : ajout de l'onglet Tâches (bloc TACHES à REMPLACEMENT DE BLOC,
// seule exception à l'append-only - voir README), navigation par hash (#journal/#plans/#taches,
// compatible #e<id>/#plan-<id>), en-tête opérationnel unique (compteurs Nouveau/À moi/Complété
// sans preuve, délai de silence, file "Ça t'attend"), cartes enrichies (bouton Copier ma réponse,
// ligne Prochaine action), curseur "depuis ma dernière visite" (localStorage best-effort) et
// pagination du rendu Journal (le goulot est le DOM, pas la taille du fichier - voir README,
// section "Croissance et seuils").
// Voir README du module pour le détail complet du contrat.
const SCHEMA_VERSION = 3;

// Contrat PLANS (voir README.md de ce dossier pour le détail complet) :
// { id: <entier, max+1>, quand_quebec: "AAAA-MM-JJ HHhMM Québec", quand_utc: "AAAA-MM-JJTHH:MMZ", titre: "Titre court du plan",
//   statut: "en-attente-validation" | "valide" | "rejete" | "en-cours" | "termine" | "abandonne" | "en-pause",
