// --- Presets et filtres avancés (Journal) ---

function matchesPreset(e, preset) {
  if (preset === 'a-traiter') return e.statut === 'en-attente';
  if (preset === 'questions-ouvertes') return (e.type === 'question-pour-stephane' || e.type === 'decision-requise') && e.statut !== 'clos';
  if (preset === 'decisions-indications') return (e.type === 'reponse-de-claude' || e.type === 'indication' || e.type === 'note');
  return true; // 'tout'
}

function matchesAdvanced(e) {
  if (filters.types.size && !filters.types.has(e.type)) return false;
  if (filters.statuts.size && !filters.statuts.has(e.statut)) return false;
  if (filters.priorites.size && !filters.priorites.has(e.priorite)) return false;
  return true;
}

function matchesSearch(e, searchTerms) {
  if (!searchTerms.length) return true;
  const sujet = normalize(e.sujet);
  const contenu = normalize(e.contenu.replace(/<[^>]*>/g, ''));
  const type = normalize(TYPE_LABELS[e.type] || e.type);
  const statut = normalize(STATUT_LABELS[e.statut] || e.statut);
  const combined = sujet + ' ' + contenu + ' ' + type + ' ' + statut;
  return searchTerms.every(t => combined.includes(t));
}

function updatePresetCounts() {
  const counts = {
    'a-traiter': ENTREES.filter(e => e.statut === 'en-attente').length,
    'questions-ouvertes': ENTREES.filter(e => (e.type === 'question-pour-stephane' || e.type === 'decision-requise') && e.statut !== 'clos').length,
    'decisions-indications': ENTREES.filter(e => e.type === 'reponse-de-claude' || e.type === 'indication' || e.type === 'note').length,
    'tout': ENTREES.length
  };
  document.querySelectorAll('.preset-btn').forEach(btn => {
    const key = btn.dataset.preset;
    btn.textContent = btn.dataset.label + ' (' + counts[key] + ')';
  });
}

function updatePresetButtons() {
  document.querySelectorAll('.preset-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.preset === filters.preset);
  });
}

document.querySelectorAll('.preset-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    filters.preset = this.dataset.preset;
    filters.onlyNew = false;
    journalRenderLimit = JOURNAL_PAGE_SIZE;
    try { localStorage.setItem('journal-preset', filters.preset); } catch (e) {}
    updatePresetButtons();
    render();
  });
});

document.querySelectorAll('.adv-checkbox input[type="checkbox"]').forEach(cb => {
  cb.addEventListener('change', function () {
    const group = this.dataset.group;
    const set = group === 'type' ? filters.types : (group === 'statut' ? filters.statuts : filters.priorites);
    if (this.checked) { set.add(this.value); } else { set.delete(this.value); }
    journalRenderLimit = JOURNAL_PAGE_SIZE;
    render();
  });
});

document.getElementById('btnResetAdv').addEventListener('click', function () {
  document.querySelectorAll('.adv-checkbox input[type="checkbox"]').forEach(cb => { cb.checked = false; });
  filters.types.clear();
  filters.statuts.clear();
  filters.priorites.clear();
  journalRenderLimit = JOURNAL_PAGE_SIZE;
  render();
});

function render() {
  // Recherche multi-mots : chaque mot tapé doit apparaître quelque part dans l'entrée, peu importe l'ordre.
  const searchTerms = normalize(filters.search).split(/\s+/).filter(Boolean);

  const withoutPreset = ENTREES.filter(e => matchesAdvanced(e) && matchesSearch(e, searchTerms));
  let filtered = withoutPreset.filter(e => matchesPreset(e, filters.preset));
  if (filters.onlyNew) { filtered = filtered.filter(isNew); }

  const sorted = [...filtered].sort((a, b) => b.id - a.id);
  countBar.textContent = sorted.length + ' entrée' + (sorted.length > 1 ? 's' : '') + ' affichée' + (sorted.length > 1 ? 's' : '') + ' sur ' + ENTREES.length;

  const maskedCount = withoutPreset.length - filtered.length;
  if (maskedCount > 0 && (filters.preset !== 'tout' || filters.onlyNew)) {
    maskedNote.classList.remove('hidden');
    maskedNote.innerHTML = maskedCount + ' élément' + (maskedCount > 1 ? 's' : '') + ' masqué' + (maskedCount > 1 ? 's' : '') + ' - <button type="button" class="btn-voir-tout" id="btnVoirTout">Voir tout</button>';
    document.getElementById('btnVoirTout').addEventListener('click', function () {
      filters.preset = 'tout';
      filters.onlyNew = false;
      journalRenderLimit = JOURNAL_PAGE_SIZE;
      try { localStorage.setItem('journal-preset', 'tout'); } catch (e) {}
      updatePresetButtons();
      render();
    });
  } else {
    maskedNote.classList.add('hidden');
    maskedNote.innerHTML = '';
  }

  if (sorted.length === 0) {
    container.innerHTML = '<div class="no-results">Aucune entrée ne correspond aux filtres sélectionnés.</div>';
    if (btnAfficherPlus) btnAfficherPlus.classList.add('hidden');
    return;
  }

  const toRender = sorted.slice(0, journalRenderLimit);
  const showSeparator = storageOk && cursorValue !== null;
  let separatorInserted = false;
  let html = '';
  for (const e of toRender) {
    if (showSeparator && !separatorInserted && !isNew(e)) {
      if (html !== '') {
        html += '<div class="separateur-visite">Depuis ta dernière visite</div>';
      }
      separatorInserted = true;
    }

    const color = TYPE_COLORS[e.type] || '#999';
    const typeLabel = TYPE_LABELS[e.type] || e.type;
    const statutLabel = STATUT_LABELS[e.statut] || e.statut;
    const prioriteLabel = PRIORITE_LABELS[e.priorite] || e.priorite;
    const liensHtml = e.liens && e.liens.length > 0
      ? e.liens.map(l => '<a href="' + l.href + '" target="_blank">' + l.titre + '</a>').join('')
      : '';
    const todoHtml = e.todo ? '<span class="card-todo">tâche #' + e.todo + '</span>' : '';
    const statutClass = e.statut;
    const copyReponseHtml = (e.statut === 'en-attente' && (e.type === 'question-pour-stephane' || e.type === 'decision-requise'))
      ? '<button class="btn-copy-reponse" data-copyid="' + e.id + '">Copier ma réponse</button>'
      : '';

    html += '<div class="card" id="e' + e.id + '">'
      + '<div class="card-header">'
      + '<span class="pastille" style="background:' + color + ';"></span>'
      + '<span class="type-label" style="color:' + color + ';">' + typeLabel + '</span>'
      + '</div>'
      + '<div class="card-sujet">' + e.sujet + '</div>'
      + '<div class="card-horodatage"><span>' + e.quand_quebec + '</span><span class="utc">(' + e.quand_utc + ')</span></div>'
      + '<div class="card-contenu rich-content">' + e.contenu + '</div>'
      + '<div class="card-badges">'
      + '<span class="badge statut ' + statutClass + '">' + statutLabel + '</span>'
      + '<span class="badge priorite ' + e.priorite + '">' + prioriteLabel + '</span>'
      + todoHtml
      + '</div>'
      + (liensHtml ? '<div class="card-links">' + liensHtml + '</div>' : '')
      + '<div class="card-actions"><button class="btn-copy-link" data-id="' + e.id + '">Copier le lien</button>' + copyReponseHtml + '</div>'
      + '</div>';
  }
  container.innerHTML = html;

  document.querySelectorAll('#cardsContainer .btn-copy-link').forEach(btn => {
    btn.addEventListener('click', function () {
      const id = this.dataset.id;
      const url = window.location.href.split('#')[0] + '#e' + id;
      const self = this;
      function done() {
        self.textContent = 'Copié !';
        setTimeout(() => { self.textContent = 'Copier le lien'; }, 1500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(() => fallbackCopy(url, done));
      } else {
        fallbackCopy(url, done);
      }
    });
  });

  document.querySelectorAll('#cardsContainer .btn-copy-reponse').forEach(btn => {
    btn.addEventListener('click', function () {
      const id = this.dataset.copyid;
      const text = 'Réponse à la question #' + id + ' du journal : ';
      const self = this;
      function done() {
        self.textContent = 'Copié !';
        setTimeout(() => { self.textContent = 'Copier ma réponse'; }, 1500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
      } else {
        fallbackCopy(text, done);
      }
    });
  });

  const remaining = sorted.length - toRender.length;
  if (btnAfficherPlus) {
    if (remaining > 0) {
      btnAfficherPlus.classList.remove('hidden');
      btnAfficherPlus.textContent = 'Afficher les 50 suivantes (' + remaining + ' restante' + (remaining > 1 ? 's' : '') + ')';
    } else {
      btnAfficherPlus.classList.add('hidden');
    }
  }
}

if (btnAfficherPlus) {
  btnAfficherPlus.addEventListener('click', function () {
    journalRenderLimit += JOURNAL_PAGE_SIZE;
    render();
  });
}

function fallbackCopy(text, done) {
  const input = document.createElement('input');
  input.value = text;
  document.body.appendChild(input);
  input.select();
  document.execCommand('copy');
  document.body.removeChild(input);
  done();
}

searchInput.addEventListener('input', function () {
  filters.search = this.value;
  filters.onlyNew = false;
  journalRenderLimit = JOURNAL_PAGE_SIZE;
  render();
});

// --- Onglet Plans ---

function renderPlans() {
  const sorted = [...PLANS].sort((a, b) => b.id - a.id);
  countBarPlans.textContent = sorted.length + ' plan' + (sorted.length > 1 ? 's' : '') + ' affiché' + (sorted.length > 1 ? 's' : '') + ' sur ' + PLANS.length;

  if (sorted.length === 0) {
    plansContainer.innerHTML = '<div class="no-results">Aucun plan pour le moment. Les plans de travail demandés à Claude apparaîtront ici, avec leur progression.</div>';
    return;
  }

  let html = '';
  for (const p of sorted) {
    const statutLabel = PLAN_STATUT_LABELS[p.statut] || p.statut;
    const liensHtml = p.liens && p.liens.length > 0
      ? p.liens.map(l => '<a href="' + l.href + '" target="_blank">' + l.titre + '</a>').join('')
      : '';

    html += '<div class="card" id="plan-' + p.id + '">'
      + '<div class="card-sujet">' + p.titre + '</div>'
      + '<div class="card-horodatage"><span>' + p.quand_quebec + '</span><span class="utc">(' + p.quand_utc + ')</span></div>'
      + '<div class="card-badges"><span class="badge plan-statut ' + p.statut + '">' + statutLabel + '</span></div>'
      + '<div class="card-contenu rich-content">' + p.contenu + '</div>'
      + (liensHtml ? '<div class="card-links">' + liensHtml + '</div>' : '')
      + '<div class="card-actions"><button class="btn-copy-link" data-planid="' + p.id + '">Copier le lien</button></div>'
      + '</div>';
  }
  plansContainer.innerHTML = html;

  document.querySelectorAll('#plansContainer .btn-copy-link').forEach(btn => {
    btn.addEventListener('click', function () {
      const id = this.dataset.planid;
      const url = window.location.href.split('#')[0] + '#plan-' + id;
      const self = this;
      function done() {
        self.textContent = 'Copié !';
        setTimeout(() => { self.textContent = 'Copier le lien'; }, 1500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(() => fallbackCopy(url, done));
      } else {
        fallbackCopy(url, done);
      }
    });
  });
}

// --- Onglet Tâches ---

function renderTacheItem(t) {
  let statutClass = t.statut;
  let statutLabel = TACHE_STATUT_LABELS[t.statut] || t.statut;
  const sansPreuve = tacheSansPreuve(t);
  if (sansPreuve) { statutClass = 'sans-preuve'; }

  let metaLines = '';
  if (t.attend) {
    metaLines += '<div>Attend : ' + t.attend + '</div>';
  }
  if ((t.statut === 'en_cours' || t.statut === 'bloque') && t.prochaine_action) {
    metaLines += '<div>Prochaine action : ' + t.prochaine_action + '</div>';
  }
  if (t.statut === 'complete') {
    if (sansPreuve) {
      metaLines += '<div>Complétée sans preuve consignée</div>';
    } else if (t.preuve) {
      metaLines += '<div>Preuve : ' + t.preuve + '</div>';
    }
  }

  return '<div class="tache-item" id="tache-' + t.n + '">'
    + '<div class="tache-header">'
    + '<span class="pastille" style="background:' + (TACHE_STATUT_COLOR(statutClass)) + ';"></span>'
    + '<span class="tache-n">#' + t.n + '</span>'
    + '<span class="badge tache-statut ' + statutClass + '">' + statutLabel + '</span>'
    + '</div>'
    + '<div class="tache-sujet">' + t.sujet + '</div>'
    + '<div class="card-horodatage"><span>' + (t.quand || '') + '</span></div>'
    + (metaLines ? '<div class="tache-meta">' + metaLines + '</div>' : '')
    + '</div>';
}

function TACHE_STATUT_COLOR(statutClass) {
  const map = { bloque: '#d32f2f', en_cours: '#1976d2', a_venir: '#607d8b', complete: '#388e3c', 'sans-preuve': '#ffa000' };
  return map[statutClass] || '#999';
}

function renderTaches() {
  const countBarTaches = document.getElementById('countBarTaches');
  const tachesContainer = document.getElementById('tachesContainer');
  const tachesMaskedNote = document.getElementById('tachesMaskedNote');

  if (tachesFilter === 'sans-preuve') {
    const list = TACHES.filter(tacheSansPreuve);
    countBarTaches.textContent = list.length + ' tâche' + (list.length > 1 ? 's' : '') + ' complétée' + (list.length > 1 ? 's' : '') + ' sans preuve sur ' + TACHES.length;
    tachesMaskedNote.classList.remove('hidden');
    tachesMaskedNote.innerHTML = 'Filtre actif : complétées sans preuve - <button type="button" class="btn-voir-tout" id="btnTachesVoirTout">Voir toutes les tâches</button>';
    document.getElementById('btnTachesVoirTout').addEventListener('click', function () {
      tachesFilter = 'tout';
      renderTaches();
    });
    tachesContainer.innerHTML = list.length === 0
      ? '<div class="no-results">Aucune tâche complétée sans preuve.</div>'
      : list.map(renderTacheItem).join('');
    return;
  }

  tachesMaskedNote.classList.add('hidden');
  tachesMaskedNote.innerHTML = '';

  if (TACHES.length === 0) {
    countBarTaches.textContent = 'Aucune tâche affichée';
    tachesContainer.innerHTML = '<div class="no-results">Aucune tâche pour le moment.</div>';
    return;
  }

  countBarTaches.textContent = TACHES.length + ' tâche' + (TACHES.length > 1 ? 's' : '') + ' (synchronisé ' + (TACHES_META.synchronise_le || '-') + ')';

  const groupes = { bloque: [], en_cours: [], a_venir: [], complete: [] };
  TACHES.forEach(t => { (groupes[t.statut] || groupes.a_venir).push(t); });

  let html = '';
  TACHE_ORDRE_GROUPES.forEach(key => {
    const items = groupes[key];
    if (!items.length) return;
    html += '<div class="taches-groupe"><div class="taches-groupe-titre">' + TACHE_GROUPE_TITRES[key] + ' (' + items.length + ')</div>';
    if (key === 'complete') {
      for (let i = 0; i < items.length; i += 50) {
        const chunk = items.slice(i, i + 50);
        const debut = i + 1, fin = Math.min(i + 50, items.length);
        html += '<details class="taches-collapse-groupe"><summary>Tâches ' + debut + '-' + fin + ' (' + chunk.length + ')</summary>';
        html += chunk.map(renderTacheItem).join('');
        html += '</details>';
      }
    } else {
      html += items.map(renderTacheItem).join('');
    }
    html += '</div>';
  });
  tachesContainer.innerHTML = html;
}

// --- Liens directs (#e<id> vers une entrée, #plan-<id> vers un plan, #journal/#plans/#taches vers un onglet) ---

function scrollAndHighlight(hash) {
  requestAnimationFrame(() => {
    const target = document.querySelector(hash);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('highlight');
      setTimeout(() => { target.classList.remove('highlight'); }, 2000);
    }
  });
}

function handleHash() {
  const hash = window.location.hash;
  const planMatch = hash.match(/^#plan-(\d+)$/);
  const entryMatch = hash.match(/^#e(\d+)$/);
  if (planMatch) {
    switchTab('plans', { updateHash: false });
    scrollAndHighlight('#plan-' + planMatch[1]);
  } else if (entryMatch) {
    switchTab('journal', { updateHash: false });
    // Un lien direct vers une entrée doit toujours la trouver : on efface tout filtre qui
    // pourrait la masquer (recherche, filtres avancés), et on étend la pagination si nécessaire.
    filters.preset = 'tout';
    filters.onlyNew = false;
    filters.search = '';
    searchInput.value = '';
    filters.types.clear();
    filters.statuts.clear();
    filters.priorites.clear();
    document.querySelectorAll('.adv-checkbox input[type="checkbox"]').forEach(cb => { cb.checked = false; });
    try { localStorage.setItem('journal-preset', 'tout'); } catch (e) {}
    updatePresetButtons();
    const targetId = parseInt(entryMatch[1], 10);
    const idx = [...ENTREES].sort((a, b) => b.id - a.id).findIndex(e => e.id === targetId);
    if (idx >= 0 && idx >= journalRenderLimit) {
      journalRenderLimit = Math.ceil((idx + 1) / JOURNAL_PAGE_SIZE) * JOURNAL_PAGE_SIZE;
    }
    render();
    scrollAndHighlight(entryMatch[0]);
  } else if (hash === '#plans') {
    switchTab('plans', { updateHash: false });
  } else if (hash === '#taches') {
    switchTab('taches', { updateHash: false });
  } else if (hash === '#journal') {
    switchTab('journal', { updateHash: false });
  }
}

// --- Initialisation ---

let initialTab = 'journal';
const initialHash = window.location.hash;
if (/^#(journal|plans|taches)$/.test(initialHash)) {
  initialTab = initialHash.slice(1);
} else if (/^#plan-\d+$/.test(initialHash)) {
  initialTab = 'plans';
} else if (/^#e\d+$/.test(initialHash)) {
  initialTab = 'journal';
} else {
  let storedTab = null;
  try { storedTab = localStorage.getItem('journal-active-tab'); } catch (e) {}
  if (storedTab === 'plans' || storedTab === 'taches') initialTab = storedTab;
}
switchTab(initialTab, { updateHash: false });

let storedPreset = null;
try { storedPreset = localStorage.getItem('journal-preset'); } catch (e) {}
if (storedPreset) {
  filters.preset = storedPreset;
} else {
  const aTraiterCount = ENTREES.filter(e => e.statut === 'en-attente').length;
  filters.preset = aTraiterCount > 0 ? 'a-traiter' : 'tout';
}
updatePresetButtons();

updateMeta();
updatePresetCounts();
updateOpsBar();
render();
renderPlans();
renderTaches();

handleHash();

window.addEventListener('hashchange', function () {
  document.querySelectorAll('.card.highlight, .tache-item.highlight').forEach(c => c.classList.remove('highlight'));
  handleHash();
});
</script>
