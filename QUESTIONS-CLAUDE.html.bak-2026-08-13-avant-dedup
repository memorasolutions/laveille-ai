function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  themeToggle.textContent = theme === 'dark' ? 'Thème clair' : 'Thème sombre';
  try { localStorage.setItem('journal-theme', theme); } catch (e) {}
}
