const TYPE_COLORS = {
  "question-pour-stephane": "#ff6d00",
  "decision-requise": "#d50000",
  "reponse-de-claude": "#2962ff",
  "reponse-de-stephane": "#2e7d32",
  "indication": "#7b1fa2",
  "note": "#546e7a"
};

const TYPE_LABELS = {
  "question-pour-stephane": "Question pour Stéphane",
  "decision-requise": "Décision requise",
  "reponse-de-claude": "Réponse de Claude",
  "reponse-de-stephane": "Réponse de Stéphane",
  "indication": "Indication",
  "note": "Note"
};

const STATUT_LABELS = {
  "en-attente": "En attente",
  "repondu": "Répondu",
  "clos": "Clos",
  "info": "Info"
};

const PRIORITE_LABELS = {
  "haute": "Haute",
  "normale": "Normale",
  "basse": "Basse"
};

let filters = { type: 'tous', statut: 'tous', priorite: 'tous', attenteOnly: false, search: '' };

const container = document.getElementById('cardsContainer');
const countBar = document.getElementById('countBar');
const badgeAttente = document.getElementById('badgeAttente');
const derniereMaj = document.getElementById('derniereMaj');
const searchInput = document.getElementById('searchInput');
const themeToggle = document.getElementById('themeToggle');
const btnAttenteOnly = document.getElementById('btnAttenteOnly');

function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  themeToggle.textContent = theme === 'dark' ? 'Thème clair' : 'Thème sombre';
  localStorage.setItem('journal-theme', theme);
}
const storedTheme = localStorage.getItem('journal-theme');
if (storedTheme) {
  applyTheme(storedTheme);
} else {
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  applyTheme(prefersDark ? 'dark' : 'light');
}
themeToggle.addEventListener('click', () => {
  const current = document.documentElement.getAttribute('data-theme');
  applyTheme(current === 'dark' ? 'light' : 'dark');
});

function normalize(str) {
  return str.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
}

function updateMeta() {
  const enAttente = ENTREES.filter(e => e.statut === 'en-attente').length;
  if (enAttente > 0) {
    badgeAttente.classList.remove('hidden');
    badgeAttente.textContent = enAttente + ' en attente';
  } else {
    badgeAttente.classList.add('hidden');
  }
  if (ENTREES.length > 0) {
    const last = ENTREES.reduce((max, e) => e.id > max.id ? e : max, ENTREES[0]);
    derniereMaj.textContent = 'Dernière mise à jour : ' + last.quand_quebec;
  }
}

function render() {
  // Recherche multi-mots : chaque mot tapé doit apparaître quelque part dans l'entrée, peu importe l'ordre.
  const searchTerms = normalize(filters.search).split(/\s+/).filter(Boolean);
  const filtered = ENTREES.filter(e => {
    if (filters.type !== 'tous' && e.type !== filters.type) return false;
    if (filters.statut !== 'tous' && e.statut !== filters.statut) return false;
    if (filters.priorite !== 'tous' && e.priorite !== filters.priorite) return false;
    if (filters.attenteOnly && e.statut !== 'en-attente') return false;
    if (searchTerms.length) {
      const sujet = normalize(e.sujet);
      const contenu = normalize(e.contenu.replace(/<[^>]*>/g, ''));
      const type = normalize(TYPE_LABELS[e.type] || e.type);
      const statut = normalize(STATUT_LABELS[e.statut] || e.statut);
      const combined = sujet + ' ' + contenu + ' ' + type + ' ' + statut;
      if (!searchTerms.every(t => combined.includes(t))) return false;
    }
    return true;
  });

  const sorted = [...filtered].sort((a, b) => b.id - a.id);
  countBar.textContent = sorted.length + ' entrée' + (sorted.length > 1 ? 's' : '') + ' affichée' + (sorted.length > 1 ? 's' : '') + ' sur ' + ENTREES.length;

  if (sorted.length === 0) {
    container.innerHTML = '<div class="no-results">Aucune entrée ne correspond aux filtres sélectionnés.</div>';
    return;
  }

  let html = '';
  for (const e of sorted) {
    const color = TYPE_COLORS[e.type] || '#999';
    const typeLabel = TYPE_LABELS[e.type] || e.type;
    const statutLabel = STATUT_LABELS[e.statut] || e.statut;
    const prioriteLabel = PRIORITE_LABELS[e.priorite] || e.priorite;
    const liensHtml = e.liens && e.liens.length > 0
      ? e.liens.map(l => '<a href="' + l.href + '" target="_blank">' + l.titre + '</a>').join('')
      : '';
    const todoHtml = e.todo ? '<span class="card-todo">tâche #' + e.todo + '</span>' : '';
    const statutClass = e.statut;

    html += '<div class="card" id="e' + e.id + '">'
      + '<div class="card-header">'
      + '<span class="pastille" style="background:' + color + ';"></span>'
      + '<span class="type-label" style="color:' + color + ';">' + typeLabel + '</span>'
      + '</div>'
      + '<div class="card-sujet">' + e.sujet + '</div>'
      + '<div class="card-horodatage"><span>' + e.quand_quebec + '</span><span class="utc">(' + e.quand_utc + ')</span></div>'
      + '<div class="card-contenu">' + e.contenu + '</div>'
      + '<div class="card-badges">'
      + '<span class="badge statut ' + statutClass + '">' + statutLabel + '</span>'
      + '<span class="badge priorite ' + e.priorite + '">' + prioriteLabel + '</span>'
      + todoHtml
      + '</div>'
      + (liensHtml ? '<div class="card-links">' + liensHtml + '</div>' : '')
      + '<div class="card-actions"><button class="btn-copy-link" data-id="' + e.id + '">Copier le lien</button></div>'
      + '</div>';
  }
  container.innerHTML = html;

  document.querySelectorAll('.btn-copy-link').forEach(btn => {
    btn.addEventListener('click', function() {
      const id = this.dataset.id;
      const url = window.location.href.split('#')[0] + '#e' + id;
      const self = this;
      function done() {
        self.textContent = 'Copié !';
        setTimeout(() => { self.textContent = 'Copier le lien'; }, 1500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(() => fallbackCopy(url, done));
      } else {
        fallbackCopy(url, done);
      }
    });
  });

  if (window.location.hash) {
    const target = document.querySelector(window.location.hash);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('highlight');
      setTimeout(() => { target.classList.remove('highlight'); }, 2000);
    }
  }
}

function fallbackCopy(text, done) {
  const input = document.createElement('input');
  input.value = text;
  document.body.appendChild(input);
  input.select();
  document.execCommand('copy');
  document.body.removeChild(input);
  done();
}

document.querySelectorAll('.filter-btn[data-filter]').forEach(btn => {
  btn.addEventListener('click', function() {
    const filter = this.dataset.filter;
    const value = this.dataset.value;
    const group = this.closest('.filter-group');
    group.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    filters[filter] = value;
    render();
  });
});

btnAttenteOnly.addEventListener('click', function() {
  filters.attenteOnly = !filters.attenteOnly;
  this.classList.toggle('active');
  render();
});

searchInput.addEventListener('input', function() {
  filters.search = this.value;
  render();
});

updateMeta();
render();

window.addEventListener('hashchange', function() {
  document.querySelectorAll('.card.highlight').forEach(c => c.classList.remove('highlight'));
  if (window.location.hash) {
    const target = document.querySelector(window.location.hash);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('highlight');
      setTimeout(() => { target.classList.remove('highlight'); }, 2000);
    }
  }
});
</script>
