platform: "Académie — La veille de Stef (LMS)"
url_racine: "https://laveille.ai/academie"
environnement: production
posture: "lecture seule stricte sauf actions de simulation explicitement marquées ecriture ; comptes @memora.ca prefixes SIM_{run_id} ; teardown obligatoire"
run_id: acad-20260702
date: 2026-07-02
fuseau: America/Toronto
navigateur: "Chrome (Playwright VISIBLE, non-headless — obligatoire)"
contexte: "Simulation demandee par l'utilisateur : tous les roles, simulation + audit UX/UI simultanes, focus placement boutons/menus, longueur de page et candidats onglets/accordeon. Perimetre : Academie SEULEMENT (precise apres coup par l'utilisateur, pas le site entier)."
incident_p0_corrige: "Bug bloquant /gerer (500, Class Google\\Service\\Calendar not found, dependance composer google/apiclient jamais installee en prod) decouvert et corrige avant la cartographie. Voir memoire pipeline-composer-install-manquant-2026-07-02."

gates:
  fonctionnel: bloquant
  ux_ui_intuitif: bloquant
  wcag_2_2_aaa: bloquant
  console_reseau_0_erreur: bloquant
  longueur_page_structure: bloquant
  navigations_directes_max: 1

roles:
  - id: superadmin
    compte: "stephane@memora.ca"
    description: "Voit tout : administration Academie + module Academie complet + tous les cours"
  - id: formateur
    compte: "SIM_acad20260702_formateur@memora.ca"
    description: "Proprietaire d'un ou plusieurs cours, gere son contenu, ses eleves, ses evaluations"
  - id: apprenant
    compte: "SIM_acad20260702_eleve@memora.ca"
    description: "Inscrit a un cours, suit les lecons, passe les evaluations, obtient badges/certificats"
  - id: visiteur_anonyme
    compte: null
    description: "Academie actuellement en mode admin-only (flag academy.under_construction) : voit une page bientot disponible, pas d'acces reel au contenu"

inventaire_feat:
  # Public / catalogue
  - { id: FEAT_01, nom: "Accueil Academie (/academie) : nav + recherche/filtres + catalogue de cours", crit: P0, couche: full-stack, page: courte }
  - { id: FEAT_02, nom: "Page cours publique : syllabus accordeon, a propos, inscription, seances en direct, sidebar continuer/partage", crit: P0, couche: full-stack, page: courte-moyenne }
  - { id: FEAT_03, nom: "Lecon individuelle : lecteur video/contenu, TTS audio, navigation prev/next, marquer complete, tuteur IA flottant", crit: P0, couche: full-stack, page: courte-moyenne }
  - { id: FEAT_04, nom: "Inscription a un cours (bouton + flux)", crit: P0, couche: full-stack }
  - { id: FEAT_05, nom: "Tuteur IA ancre au cours (RAG)", crit: P1, couche: full-stack }
  - { id: FEAT_06, nom: "Repetition espacee (SRS) / DeckPlayer", crit: P1, couche: full-stack }
  - { id: FEAT_07, nom: "Discussion sociale structuree par video (fils horodates)", crit: P2, couche: full-stack }
  - { id: FEAT_08, nom: "Test de positionnement adaptatif (CAT)", crit: P1, couche: full-stack }

  # Dashboard / espace utilisateur
  - { id: FEAT_09, nom: "Dashboard Mon espace (/academie/espace) : Mes formations, progression/XP/classement, badges (accordeon), Mes cours formateur, Administration (accordeon)", crit: P0, couche: full-stack, page: moyenne-longue, structure_actuelle: "accordeon partiel (badges + admin repliables)" }
  - { id: FEAT_10, nom: "Gamification (points/niveaux/ligues/defis)", crit: P2, couche: full-stack }
  - { id: FEAT_11, nom: "Badges Open Badges 3.0 verifiables + wallet", crit: P1, couche: full-stack }
  - { id: FEAT_12, nom: "Notifications intelligentes / nudges comportementaux", crit: P2, couche: full-stack }
  - { id: FEAT_13, nom: "Analytics predictifs (risque abandon) + dashboards par role", crit: P1, couche: full-stack }
  - { id: FEAT_14, nom: "Export CSV (3 boutons dans Administration)", crit: P2, couche: full-stack }

  # Editeur de cours formateur — LA page critique
  - { id: FEAT_15, nom: "Editeur /gerer : Metadonnees du cours", crit: P0, couche: full-stack, page: TRES_LONGUE, structure_actuelle: "aucune (page continue unique)" }
  - { id: FEAT_16, nom: "Editeur /gerer : Contenu formation (chapitres/lecons/items, menus kebab ⋮, Monter/Descendre)", crit: P0, couche: full-stack }
  - { id: FEAT_17, nom: "Editeur /gerer : Authoring IA (generer plan/quiz depuis un prompt)", crit: P1, couche: full-stack }
  - { id: FEAT_18, nom: "Editeur /gerer : Traduction/localisation IA + narration TTS", crit: P2, couche: full-stack }
  - { id: FEAT_19, nom: "Editeur /gerer : Supprimer la formation (positionne au MILIEU de la page — finding UX)", crit: P0, couche: full-stack }
  - { id: FEAT_20, nom: "Editeur /gerer : Devoirs et carnet de notes (grilles d'evaluation, correction)", crit: P0, couche: full-stack }
  - { id: FEAT_21, nom: "Editeur /gerer : Competences (graphe de competences pondere xAPI)", crit: P1, couche: full-stack }
  - { id: FEAT_22, nom: "Editeur /gerer : Seances en direct (Google Meet auto-creation)", crit: P1, couche: full-stack }
  - { id: FEAT_23, nom: "Editeur /gerer : Essais a corriger (workshop peer-assessment)", crit: P2, couche: full-stack }
  - { id: FEAT_24, nom: "Editeur /gerer : Inscriptions et equipe (cohortes, roles de cours)", crit: P0, couche: full-stack }
  - { id: FEAT_25, nom: "Certificat / diplomation (Konva editeur, bibliotheque, emission reelle)", crit: P1, couche: full-stack, note: "bibliotheque de gabarits NON localisee via clics — a verifier en Phase 3" }
  - { id: FEAT_26, nom: "Creer un cours (/academie/creer) : formulaire minimal", crit: P0, couche: full-stack, page: tres_courte }
  - { id: FEAT_27, nom: "Banque de questions (/academie/banque) : categories + questions, 4 types (QCM/VF/court/appariement)", crit: P0, couche: full-stack, page: courte-moyenne }
  - { id: FEAT_28, nom: "Duplication de cours", crit: P2, couche: full-stack }
  - { id: FEAT_29, nom: "Statistiques / Rapports formateur", crit: P1, couche: full-stack }

  # Interop / avance
  - { id: FEAT_30, nom: "xAPI leger (statements actor-verb-object)", crit: P2, couche: backend }
  - { id: FEAT_31, nom: "LTI 1.3 consumer (outils externes)", crit: P2, couche: full-stack }
  - { id: FEAT_32, nom: "Graphe de competences (mastery, prerequis)", crit: P1, couche: full-stack }

  # Admin racine (hors module Academie mais lie)
  - { id: FEAT_33, nom: "Paliers d'abonnement (/admin/academy/subscription-tiers) — situe dans admin racine, pas sous Academie", crit: P1, couche: full-stack, page: tres_courte, finding_ux: "emplacement discutable, 2 points d'entree Academie separes dans le menu admin" }
  - { id: FEAT_34, nom: "Analytiques organisation (predictive_analytics_enabled)", crit: P2, couche: full-stack }

total_feat: 34

findings_ux_phase1:
  - id: UX_01
    severite: P0
    page: "/academie/courses/{slug}/gerer"
    probleme: "Page unique tres longue (8-10 ecrans estimes), ~10 sections empilees SANS onglets, accordeon ni sommaire de navigation interne"
    impact: "Un formateur non technique doit scroller enormement pour trouver une section ; aucun moyen de sauter directement a Devoirs ou Seances en direct"
  - id: UX_02
    severite: P1
    page: "/academie/courses/{slug}/gerer"
    probleme: "Bouton Supprimer ce cours positionne au MILIEU de la page plutot qu'isole en fin (zone dangereuse a proximite d'actions courantes)"
  - id: UX_03
    severite: P2
    page: "/academie/courses/{slug}/gerer"
    probleme: "Menus kebab ⋮ repetes a chaque niveau hierarchique (chapitre/lecon/item), dense visuellement"
  - id: UX_04
    severite: P2
    page: "/academie/courses/{slug} (page publique)"
    probleme: "Pas de lien Gerer visible meme en admin sur la page publique du cours, il faut repasser par Mon espace"
  - id: UX_05
    severite: P2
    page: "/academie/espace"
    probleme: "Lien Gerer enterre au 4e bloc (Mes cours formateur), accordeon suffisant pour le volume actuel mais a surveiller si ca grossit"
  - id: UX_06
    severite: P2
    page: "/admin (menu general)"
    probleme: "Academie a 2 points d'entree separes (Academie + Paliers Academie) au lieu d'un sous-menu unique deplie, incoherent avec le pattern accordeon des autres sections admin"
  - id: UX_07
    severite: P2
    page: "gabarits de diplomes"
    probleme: "Bibliotheque de gabarits non localisee via navigation par clics (verifier en Phase 3 si reellement absente ou juste mal exposee)"
