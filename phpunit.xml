<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         executionOrder="defects"
>
    <testsuites>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>Modules/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules/Api/app</directory>
            <directory>Modules/Auth/app</directory>
            <directory>Modules/Backoffice/app</directory>
            <directory>Modules/Backup/app</directory>
            <directory>Modules/Core/app</directory>
            <directory>Modules/Export/app</directory>
            <directory>Modules/FrontTheme/app</directory>
            <directory>Modules/Health/app</directory>
            <directory>Modules/Logging/app</directory>
            <directory>Modules/Media/app</directory>
            <directory>Modules/Notifications/app</directory>
            <directory>Modules/RolesPermissions/app</directory>
            <directory>Modules/SaaS/app</directory>
            <directory>Modules/Search/app</directory>
            <directory>Modules/SEO/app</directory>
            <directory>Modules/Settings/app</directory>
            <directory>Modules/Storage/app</directory>
            <directory>Modules/Tenancy/app</directory>
            <directory>Modules/Translation/app</directory>
            <directory>Modules/Webhooks/app</directory>
            <directory>Modules/Privacy/app</directory>
        </include>
        <exclude>
            <directory suffix=".php">Modules/*/app/Livewire</directory>
            <directory suffix=".php">Modules/Backoffice/app</directory>
        </exclude>
    </source>
    <php>
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <!-- .env.example porte le placeholder Laravel de base ("Laravel"), jamais le vrai nom du
             site - seul le vrai .env non versionne le corrige en local. Sur CI (cp .env.example ->
             .env), config('app.name') restait donc a "Laravel", ce que S111EnhancementsTest
             (manifest PWA, config/pwa.php:15 = env('APP_NAME', 'Laravel')) detectait a coup sur.
             Verifie sans risque : aucun test du depot n'attend la valeur par defaut "Laravel" pour
             config('app.name') (les 4 occurrences litterales de "Laravel" ailleurs sont des
             donnees de fixture - noms de categorie/article - sans rapport avec APP_NAME). -->
        <env name="APP_NAME" value="La veille"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="RESPONSE_CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="RESPONSE_CACHE_ENABLED" value="false"/>
        <!-- Le controle du credit OpenRouter est ACTIF par defaut en production, volontairement.
             Ici il doit etre eteint : Phase183Test appelle `health:check`, qui executerait tous
             les controles enregistres - donc un vrai appel reseau a openrouter.ai, avec la vraie
             cle, a chaque passage de la suite. Le controle lui-meme reste couvert par
             Modules/Health/tests/Feature/OpenRouterCreditCheckTest.php, qui l'instancie
             directement avec Http::fake. -->
        <env name="HEALTH_OPENROUTER_ENABLED" value="false"/>
        <!-- Cle FACTICE, jamais une vraie credential : de nombreux tests News (AiSummaryService,
             Http::fake sur openrouter.ai/*) lisent config('services.openrouter.api_key') et
             retournent null SANS appeler Http si elle est vide (garde legitime du service).
             En local, le vrai .env non versionne porte une vraie cle -> ces tests passent.
             Sur CI, cp .env.example -> .env ne definit jamais OPENROUTER_API_KEY (absente du
             gabarit) -> la garde coupait l'appel avant meme Http::fake, et Http::assertSent()
             echouait a coup sur (aucune requete envoyee). Meme valeur factice deja utilisee au
             cas par cas dans CompositionCandidatesDuJourTest ('cle-de-test') ; ceci ne fait que
             la fournir par defaut aux tests qui l'ont simplement omise. Un test qui doit prouver
             le comportement "cle absente" peut toujours l'ecraser localement via
             config()->set('services.openrouter.api_key', null). -->
        <env name="OPENROUTER_API_KEY" value="cle-de-test"/>
    </php>
</phpunit>
